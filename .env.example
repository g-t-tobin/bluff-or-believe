# Frontend runtime configuration (Vite)
# Local development defaults remain valid for a laptop session.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
# Production uses the same-origin CloudFront /api proxy; WebSockets derive WSS from the page origin.
# VITE_API_BASE_URL=/api
# Leave VITE_WS_BASE_URL unset in production.

# Backend runtime configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production configuration for the frontend custom domain.
# CORS_ORIGINS=https://play.ai-autofy-general-server.com
HOST=0.0.0.0
PORT=8000

# Optional HTTPS configuration for the ALB and custom CloudFront domains.
# The ALB certificate must live in eu-west-1. The CloudFront certificate must live in us-east-1.
# API_DOMAIN_NAME=api.ai-autofy-general-server.com
# API_CERTIFICATE_ARN=arn:aws:acm:eu-west-1:851725545966:certificate/97548b1e-afa4-42c3-8cf0-a0fa57e3edd9
# FRONTEND_DOMAIN_NAME=play.ai-autofy-general-server.com
# FRONTEND_CERTIFICATE_ARN=arn:aws:acm:us-east-1:851725545966:certificate/ee586878-a05c-463c-a4ac-f13ab9d17e9b

# Local development only. Do not put real credentials or secrets in this file.
REDIS_URL=redis://localhost:6379/0
